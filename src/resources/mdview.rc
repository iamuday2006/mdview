// mdview Windows resource file
// Provides product metadata visible in file properties and Task Manager

#include <winver.h>

// Version info block
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "iamuday2006"
            VALUE "FileDescription", "mdview - a terminal Markdown workspace"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "mdview"
            VALUE "LegalCopyright", "Copyright (c) 2026 iamuday2006"
            VALUE "LegalTrademarks", ""
            VALUE "OriginalFilename", "mdview.exe"
            VALUE "ProductName", "mdview"
            VALUE "ProductVersion", "0.1.0"
            VALUE "Comments", "A terminal Markdown workspace. https://github.com/iamuday2006/mdview"
            VALUE "URL", "https://github.com/iamuday2006/mdview"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
